<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.awesomeaem.geo</groupId>
        <artifactId>awesome-aem-geo</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>awesome-aem-geo.all</artifactId>
    <packaging>content-package</packaging>
    <name>Awesome AEM GEO - All</name>
    <dependencies>
        <dependency>
            <groupId>com.awesomeaem.geo</groupId>
            <artifactId>awesome-aem-geo.ui.apps</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.awesomeaem.geo</groupId>
            <artifactId>awesome-aem-geo.ui.content</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.jackrabbit</groupId>
                <artifactId>filevault-package-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <group>com.awesomeaem.geo</group>
                    <name>awesome-aem-geo.all</name>
                    <packageType>container</packageType>
                    <skipSubPackageValidation>true</skipSubPackageValidation>
                    <embeddeds>
                        <embedded>
                            <groupId>com.awesomeaem.geo</groupId>
                            <artifactId>awesome-aem-geo.core</artifactId>
                            <target>/apps/awesome-aem-geo-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.awesomeaem.geo</groupId>
                            <artifactId>awesome-aem-geo.ui.apps</artifactId>
                            <type>zip</type>
                            <target>/apps/awesome-aem-geo-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.awesomeaem.geo</groupId>
                            <artifactId>awesome-aem-geo.ui.content</artifactId>
                            <type>zip</type>
                            <target>/apps/awesome-aem-geo-packages/content/install</target>
                        </embedded>
                    </embeddeds>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.day.jcr.vault</groupId>
                <artifactId>content-package-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <verbose>true</verbose>
                    <failOnError>true</failOnError>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>seed-local-demo-content</id>
                        <phase>install</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>sh</executable>
                            <arguments>
                                <argument>${project.basedir}/../scripts/seed-demo-content.sh</argument>
                            </arguments>
                            <environmentVariables>
                                <AEM_BASE_URL>http://${aem.host}:${aem.port}</AEM_BASE_URL>
                                <AEM_USER>${aem.user}</AEM_USER>
                                <AEM_PASSWORD>${aem.password}</AEM_PASSWORD>
                            </environmentVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>autoInstallSinglePackage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.day.jcr.vault</groupId>
                        <artifactId>content-package-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>install-package-author</id>
                                <goals>
                                    <goal>install</goal>
                                </goals>
                                <configuration>
                                    <targetURL>http://${aem.host}:${aem.port}/crx/packmgr/service.jsp</targetURL>
                                    <failOnError>true</failOnError>
                                    <userId>${aem.user}</userId>
                                    <password>${aem.password}</password>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
